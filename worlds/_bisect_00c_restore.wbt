#VRML_SIM R2025a utf8

# Faithful minimal replica of the blue helicopter from
#   projects/samples/devices/worlds/propeller.wbt
# Remote PROTOs and textures removed so it runs offline; everything that
# touches the Propeller (constants, motor fields, helix structure, physics
# block, absence of basicTimeStep) is copied exactly.
#
# If this flies, the Propeller node works in this install and the fault is in
# the DNS airframe. If it does not, the fault is environmental.

WorldInfo {
  info [
    "Replica of the official Propeller sample"
  ]
  title "Propeller probe"
}
Viewpoint {
  orientation -0.286 0.493 0.821 1.23
  position -0.76 -1.35 1.14
}
Background {
  skyColor [
    0.2 0.2 0.3
  ]
}
DirectionalLight {
  direction 0 0 -1
  intensity 2
}
DEF PLATFORM Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.8 0.8
        roughness 0.5
        metalness 0
      }
      geometry Plane {
      }
    }
  ]
  boundingObject Pose {
    children [
      Plane {
      }
    ]
  }
  locked TRUE
}
DEF BLUE_HELICOPTER Robot {
  translation -0.193739 0.278025 -0.01
  rotation 0 0 1 -1.047195
  children [
    GPS {
    }
    InertialUnit {
      rotation 0 0 1 3.14159
    }
    DEF BODY Pose {
      translation 0 0 0.1
      rotation -0.5773509358554485 -0.5773509358554485 -0.5773489358556708 -2.094397
      children [
        Shape {
          appearance DEF BLUE_METAL PBRAppearance {
            baseColor 0.027451 0.0392157 0.941176
            roughness 0
            metalness 0
          }
          geometry Capsule {
            height 0.1
            radius 0.05
            subdivision 24
          }
        }
      ]
    }
    DEF MAIN_AXLE_LARGE Pose {
      translation 0.01 0 0.16
      children [
        Shape {
          appearance USE BLUE_METAL
          geometry Cylinder {
            bottom FALSE
            height 0.02
            radius 0.02
            subdivision 24
          }
        }
      ]
    }
    DEF MAIN_AXLE_THIN Pose {
      translation 0.01 0 0.16
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.8 0.8 0.8
            roughness 0
            metalness 0
          }
          geometry Cylinder {
            height 0.07
            radius 0.004
            subdivision 24
          }
        }
      ]
    }
    DEF AXIAL_ROTOR Propeller {
      shaftAxis 0 0 1
      centerOfThrust 0.0122777 0 0.19
      thrustConstants 0.00163465 0.001
      torqueConstants 1e-07 1e-07
      device RotationalMotor {
        name "motor"
        acceleration 50
        maxVelocity 400
        maxTorque 15
      }
      fastHelix DEF FAST_HELIX Solid {
        translation 0.01 0 0.2
        children [
          DEF FAST_MAIN_HELIX_SHAPE Shape {
            appearance PBRAppearance {
              transparency 0.5
              roughness 0.5
              metalness 0
            }
            geometry Cylinder {
              height 0.003
              radius 0.145
              side FALSE
              subdivision 24
            }
          }
        ]
      }
      slowHelix DEF SLOW_HELIX Solid {
        translation 0.01 0 0.2
        rotation -1 0 0 -1.570796
        children [
          Pose {
            rotation 0 0 1 1.570796
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0 0 0
                  roughness 0
                  metalness 0
                }
                geometry Cylinder {
                  height 0.07
                  radius 0.004
                }
              }
            ]
          }
        ]
      }
    }
  ]
  name "blue helicopter"
  boundingObject Group {
    children [
      USE BODY
      USE MAIN_AXLE_LARGE
      USE MAIN_AXLE_THIN
    ]
  }
  physics Physics {
    damping Damping {
    }
  }
  controller "probe_official"
  controllerArgs [
    "00c_restore"
    "+1"
  ]
  supervisor TRUE
}
