# Normalise text to LF in the repository, check out native on Windows.
* text=auto

# Explicit text types -- these must never be mangled by platform detection.
*.py      text diff=python
*.md      text
*.json    text
*.csv     text
*.txt     text
*.proto   text
*.wbt     text
*.gitattributes text
*.gitignore     text

# Binary assets: never diffed, never line-ending converted. A GIF or MP4 that
# gets CRLF-translated is silently corrupted, and the corruption only shows up
# when someone tries to play it.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary
*.mp4     binary
*.webm    binary
*.npz     binary
*.npy     binary
*.zip     binary
*.ico     binary
# SVG is XML, so it is text -- but never line-ending-mangled for other
# platforms, and excluded from diffs because generated plot SVGs are enormous.
*.svg     text eol=lf -diff

# Generated or bulky paths collapsed in diffs and excluded from language
# statistics, so the repository is reported as the Python/simulation project it
# is rather than as a pile of generated world files and logs.
results/**        linguist-generated=true
assets/**         linguist-generated=true
evidence/**       linguist-documentation=true
worlds/*.wbt      linguist-generated=true
worlds/_*.wbt     linguist-generated=true -diff
docs/**           linguist-documentation=true
